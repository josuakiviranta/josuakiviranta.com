# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local working notes and browser screenshots (never published)
/wayfinder/
/.playwright-cli/

# full-size photo originals (optimised copies live in /public when used)
/public/originals/

# LaTeX build artefacts and non-source PDFs in cv/
cv/*.log
cv/*.aux
cv/*.out
cv/*.synctex.gz
cv/cv-elias-ylonen.pdf
cv/CV-Josua-Kiviranta-8.pdf
